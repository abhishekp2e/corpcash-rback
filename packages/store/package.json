{
  "name": "@corpcash/rbac-store",
  "version": "0.2.0",
  "description": "Database adapters for persisting @corpcash/rbac-core role graphs",
  "license": "MIT",
  "author": "Corpcash",
  "homepage": "https://github.com/abhishekp2e/corpcash-rback/tree/main/packages/store#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishekp2e/corpcash-rback.git",
    "directory": "packages/store"
  },
  "bugs": {
    "url": "https://github.com/abhishekp2e/corpcash-rback/issues"
  },
  "keywords": [
    "rbac",
    "authorization",
    "postgres",
    "mysql",
    "mongodb",
    "access-control"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./mysql": {
      "import": {
        "types": "./dist/mysql.d.ts",
        "default": "./dist/mysql.js"
      },
      "require": {
        "types": "./dist/mysql.d.cts",
        "default": "./dist/mysql.cjs"
      }
    },
    "./mongodb": {
      "import": {
        "types": "./dist/mongodb.d.ts",
        "default": "./dist/mongodb.js"
      },
      "require": {
        "types": "./dist/mongodb.d.cts",
        "default": "./dist/mongodb.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "postgres": [
        "./dist/postgres.d.ts"
      ],
      "mysql": [
        "./dist/mysql.d.ts"
      ],
      "mongodb": [
        "./dist/mongodb.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test:coverage"
  },
  "dependencies": {
    "@corpcash/rbac-core": "workspace:*"
  },
  "peerDependencies": {
    "mongodb": ">=6.0.0",
    "mysql2": ">=3.0.0",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^2.1.8",
    "mongodb": "^6.16.0",
    "mysql2": "^3.14.1",
    "pg": "^8.16.0",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
